# InternShield AI - Environment Variables Reference
# Copy this file to backend/.env and update the values with your actual configuration.

# ==========================================
# Backend & Server Settings
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# MySQL 8 Database Settings
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=internshield_ai

# ==========================================
# AI Model / Provider API Key
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
