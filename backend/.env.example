# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==========================================
# Authentication & JWT Configuration
# ==========================================
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ==========================================
# MySQL 8 Database Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=internshield_ai

# ==========================================
# AI Model / Provider API Key (Server-Side Only)
# ==========================================
# Google Gemini API key obtained from https://aistudio.google.com/
# NEVER expose this key to the frontend or git repositories.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=8000

